# Copy this file to `.env` for dev (loaded from the `backend/` working
# directory -- see afterthread/config.py). A packaged install (`uvx
# afterthread` / `afterthread`, see backend/README.md) never reads
# this checkout at all: it instead reads `<data-dir>/.env`, where data-dir
# defaults to `~/.local/share/afterthread` (override with --data-dir /
# AFTERTHREAD_DATA_DIR). Copy this file there for a packaged install.

# OpenAI-compatible endpoint. Leave empty for now; fill in the real
# OpenAI-compatible endpoint URL later.
OPENAI_BASE_URL=

# API key for the OpenAI-compatible endpoint above.
OPENAI_API_KEY=

# Model name to use against the OpenAI-compatible endpoint.
OPENAI_MODEL=

# Per-request timeout (seconds) for the OpenAI-compatible endpoint. Bounded to
# (0, 1800]. Also the end-to-end deadline for a call plus its one corrective
# retry (see afterthread/services/llm.py). Default 120: a long-context model
# generating against a large prompt is legitimately slower than the small model
# the old 60s default assumed.
OPENAI_TIMEOUT_SECONDS=120

# Optional hard cap on completion length, sent as `max_tokens` ONLY when set.
# Leave it unset (commented out) to omit the parameter entirely -- some
# reasoning endpoints reject an explicit max_tokens. Set it if your gateway
# defaults to a small completion cap that truncates long structured replies
# into invalid JSON. Bounded to [1, 1000000].
# OPENAI_MAX_OUTPUT_TOKENS=8192

# TOKEN budget for the serialized item snapshot in an enrich / assist-update
# prompt AND the OpenAPI document in an installer session (see
# afterthread/services/memory_ai.py, tool_builder.py). Bounded to [4000,
# 1000000] (le = the 1M-token context window). Token-denominated because tokens
# are the model's real constraint and the number the endpoint reports back; at
# runtime it is divided by a live chars<->tokens ratio learned from recent
# completions (no tokenizer -- see afterthread/services/token_budget.py) to get
# the actual char allowance. Default 200000 tokens == the old 200000-char budget
# at the cold-start ratio 1.0. (改名自 LLM_PROMPT_BUDGET_CHARS; 舊的 *_CHARS 鍵會被
# 靜默忽略。)
LLM_PROMPT_BUDGET_TOKENS=200000

# Size of the in-memory ring of recent LLM interaction records surfaced by the
# "AI 日誌" page / GET /api/llm/logs (see afterthread/services/llm_log.py).
# Bounded to [1, 1000]. The ring is memory-only and dies with the process.
LLM_LOG_MAX_ENTRIES=50

# Hard cap on how many characters ANY single stored request-message or
# response body may occupy (a broken/hostile gateway could otherwise return a
# multi-MB body that inflates the ring above). Bounded to [1000, 2000000].
# Default 200000 matches the prompt budget's char allowance
# (LLM_PROMPT_BUDGET_TOKENS at the cold-start ratio), so an ordinary
# interaction's bodies are never truncated by this independent cap.
LLM_LOG_BODY_MAX_CHARS=200000

# Optional JSONL file every finished LLM interaction is appended to (full
# prompt/response bodies, one JSON object per line). Leave it unset (commented
# out) to keep records memory-only: they carry personal memory content, so
# landing them on disk is an opt-in privacy decision.
# LLM_LOG_FILE=./llm-interactions.jsonl

# Rotation threshold (bytes) for the JSONL sink above: once the file grows past
# this, it is renamed aside with a UTC-timestamp suffix and a fresh file starts
# (guards the disk; RAM is the ring's job). Only relevant when LLM_LOG_FILE is
# set. Bounded to [1000000, 1000000000]; default 50MB. Rotated segments are NOT
# auto-deleted -- pruning them is the operator's call.
LLM_LOG_FILE_MAX_BYTES=50000000

# --- tool calling (LLM tools) ----------------------------------------------
# Directory of installed tool packages (<tools_dir>/<name>/ with a tool.json +
# implementation files + optional .env). Leave it unset to turn the tool
# feature OFF entirely -- the AI workflows then advertise no tools and their
# prompts are byte-identical to a tool-less build. A packaged install
# (uvx/afterthread) auto-injects <data-dir>/tools, so you only set this in
# dev to opt in. See afterthread/services/tools.py.
# TOOLS_DIR=./tools

# Max agentic tool rounds a single AI call may take before it is forced to
# produce its final JSON (one round == one model reply whose tool calls were
# executed and fed back). Bounded to [1, 64]. Default 8.
LLM_TOOL_ROUNDS_MAX=8

# Wall-clock budget (seconds) for a SINGLE tool subprocess; on expiry its whole
# process group is killed. Bounded to (0, 600]. Default 60.
LLM_TOOL_TIMEOUT_SECONDS=60

# Max characters of a tool's stdout used as its result (fed back to the model);
# output past this is truncated behind a marker. Bounded to [1000, 500000].
# Default 50000.
LLM_TOOL_OUTPUT_MAX_CHARS=50000

# TOKEN budget for the live tool-loop conversation actually SENT to the model
# each round -- the SENT-side companion to the recorded-side log budget
# (LLM_LOG_BODY_MAX_CHARS bounds what is stored, not what rides on the wire). Once
# the running conversation exceeds this budget's char allowance (this value
# divided by the live chars<->tokens ratio -- see LLM_PROMPT_BUDGET_TOKENS), the
# loop stops advertising tools and makes its final tools-free completion, capping
# the pathological rounds x calls x output product. Bounded to [50000, 1000000]
# (le = the context window). Default 500000 (not 1M: at ratio 1.0 a 1M-token
# budget would fill the WHOLE context window, leaving no room for the reply).
# (改名自 LLM_TOOL_CONVERSATION_BUDGET_CHARS; 舊鍵會被靜默忽略。)
LLM_TOOL_CONVERSATION_BUDGET_TOKENS=500000

# --- web installer (工具安裝頁) ---------------------------------------------
# Tool-round budget for one installer session (write -> test -> fix cycles).
# Bounded to [4, 64]. Default 24.
TOOL_INSTALL_MAX_ROUNDS=24

# Wall-clock budget (seconds) for one whole installer session -- dozens of
# model round-trips plus real shell runs. Bounded to (0, 3600]. Default 900.
TOOL_INSTALL_TIMEOUT_SECONDS=900

# Wall-clock budget (seconds) for a single run_shell command inside an
# installer session (killed on expiry). Keep it far below the session budget
# so one hung command burns a round, not the session. Bounded to (0, 600].
# Default 120.
TOOL_INSTALL_SHELL_TIMEOUT_SECONDS=120

# --- GLM5.2 建議值（1M-token context）--------------------------------------
# 若內部 LLM 為 GLM5.2，建議調高以下兩項（取代上方預設）：
#   LLM_PROMPT_BUDGET_TOKENS=800000  # 讓超大項目也能整項進 prompt 不截斷
#   OPENAI_TIMEOUT_SECONDS=300       # 長 context 生成較慢，放寬逾時避免誤判 502

# Database connection string (SQLModel/SQLAlchemy URL). SQLite only; must be a
# file-backed path (no in-memory URLs -- see afterthread/db.py).
# Dev: leave it unset -- the default is already exactly the value below,
# resolved against backend/. Packaged mode: also leave it unset -- the
# database then automatically lands in the data dir; and even if you do set
# a relative path like this one, it is anchored to the data dir (cli.py
# chdirs there at startup), never to whatever directory the server was
# launched from.
# DATABASE_URL=sqlite:///./afterthread.db

# Days of inactivity (by `updated`) before a non-terminal item is flagged
# `is_stale` in API responses. Bounded to [0, 36500].
STALE_AFTER_DAYS=14
