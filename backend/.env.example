# Copy this file to `.env` for dev (loaded from the `backend/` working
# directory -- see context_memory/config.py). A packaged install (`uvx
# context-memory` / `context-memory`, see backend/README.md) never reads
# this checkout at all: it instead reads `<data-dir>/.env`, where data-dir
# defaults to `~/.local/share/context-memory` (override with --data-dir /
# CONTEXT_MEMORY_DATA_DIR). Copy this file there for a packaged install.

# OpenAI-compatible endpoint. Leave empty for now; fill in the real
# OpenAI-compatible endpoint URL later.
OPENAI_BASE_URL=

# API key for the OpenAI-compatible endpoint above.
OPENAI_API_KEY=

# Model name to use against the OpenAI-compatible endpoint.
OPENAI_MODEL=

# Per-request timeout (seconds) for the OpenAI-compatible endpoint. Bounded to
# (0, 600]. Also the end-to-end deadline for a call plus its one corrective
# retry (see context_memory/services/llm.py).
OPENAI_TIMEOUT_SECONDS=60

# Hard ceiling on how many characters the serialized item snapshot may occupy
# in an enrich / assist-update prompt (see context_memory/services/memory_ai.py). Bounded
# to [4000, 200000].
LLM_PROMPT_BUDGET_CHARS=32000

# Database connection string (SQLModel/SQLAlchemy URL). SQLite only; must be a
# file-backed path (no in-memory URLs -- see context_memory/db.py).
# Dev: leave it unset -- the default is already exactly the value below,
# resolved against backend/. Packaged mode: also leave it unset -- the
# database then automatically lands in the data dir; and even if you do set
# a relative path like this one, it is anchored to the data dir (cli.py
# chdirs there at startup), never to whatever directory the server was
# launched from.
# DATABASE_URL=sqlite:///./context_memory.db

# Days of inactivity (by `updated`) before a non-terminal item is flagged
# `is_stale` in API responses. Bounded to [0, 36500].
STALE_AFTER_DAYS=14
